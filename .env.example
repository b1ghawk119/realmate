# ==================== NapCat配置 ====================
NAPCAT_HTTP_URL=http://127.0.0.1:3000
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=123456

# ==================== 机器人配置 ====================
BOT_QQ=3294809636
BOT_NICKNAME=粽子

# ==================== 群白名单（重要！）====================
# 只在这些群里工作，多个群号用逗号分隔
# 留空或不设置 = 响应所有群
ENABLED_GROUPS=713984600,987654321

# ==================== 用户白名单（可选）====================
# 只响应这些用户的消息，多个QQ号用逗号分隔
# 留空或不设置 = 响应所有用户
ENABLED_USERS=2636234999

# ==================== LLM配置 ====================
# 主LLM（兼容OpenAI格式）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxx
LLM_MODEL=deepseek-chat

# ==================== 视觉模型配置 ====================
# 视觉模型（不填则使用主LLM配置）
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_API_KEY=sk-xxxxx
VISION_MODEL=Pro/Qwen/Qwen2-VL-7B-Instruct

# ==================== MCP工具服务器 ====================
MCP_SERVER_URL=http://localhost:8077
MCP_ENABLED=true

# ==================== 限制配置 ====================
MAX_HISTORY=500
MAX_CONTEXT_SEND=30
MAX_IMAGE_CACHE=50
MAX_IMAGE_ANALYSIS_COUNT=2
BUBBLE_DELAY_MIN=200
BUBBLE_DELAY_MAX=1200

# ==================== 功能开关 ====================
ENABLE_STREAM=true
ENABLE_QUESTION_DETECTION=false
ENABLE_CONTEXT_SNAPSHOT=false
ENABLE_DETAILED_LOGGING=true
ENABLE_THINKING=false

# 长消息合并转发
ENABLE_FORWARD_MSG=true
FORWARD_MSG_THRESHOLD=500
FORWARD_MSG_LINE_THRESHOLD=10

# ==================== 历史消息压缩配置 ====================
COMPRESS_TEXT=true
COMPRESS_CODE=true
COMPRESS_THRESHOLD=150
KEEP_RECENT_FULL=8
COMPRESS_CODE_LENGTH=100
COMPRESS_TEXT_LENGTH=100
